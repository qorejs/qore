{
  "name": "@qorejs/qore",
  "version": "0.7.1",
  "description": "Qore is a streaming-response framework where stream becomes signal.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "release:check": "npm test && npm pack --dry-run",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com",
    "publish:npm": "npm publish --access public",
    "prepublishOnly": "npm run release:check"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "qore",
    "stream",
    "streaming",
    "signal",
    "reactive",
    "sse",
    "ai",
    "openai",
    "anthropic",
    "framework",
    "async-iterable"
  ],
  "homepage": "https://github.com/qorejs/qore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qorejs/qore.git"
  },
  "bugs": {
    "url": "https://github.com/qorejs/qore/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
